        "light": {
          "background": "{themes.light.color.bg.sunken}",
          "text": "{themes.light.color.text.secondary}",
          "border": "{themes.light.color.border.subtle}"
        },
        "dark": {
          "background": "{themes.dark.color.bg.selected}",
          "text": "{themes.dark.color.text.secondary}",
          "border": "{themes.dark.color.border.subtle}"
        }
