{
  "$schema": "https://example.com/rook-design-tokens.schema.json",
  "name": "rook-design-tokens",
  "version": "1.0.0",
  "description": "Design tokens for the Rook application. Optimized for a calm, minimal productivity UI with explicit light and dark themes.",
  "meta": {
    "brand": "Rook",
    "principles": [
      "calm",
      "minimal",
      "mature",
      "productivity-first",
      "subtle hierarchy",
      "no neon",
      "semantic color usage"
    ],
    "usageRules": {
      "primaryColorMeaning": "Primary actions, active navigation, links, focused controls, markdown/export actions",
      "successColorMeaning": "AI, local, private, connected, success, today/current state where appropriate",
      "warningColorMeaning": "Warnings, caution, attention",
      "dangerColorMeaning": "Errors, destructive actions, dangerous states",
      "visualBalance": {
        "neutral": "75%",
        "brand": "20%",
        "semanticAccents": "5%"
      }
    }
  },
  "themes": {
    "light": {
      "color": {
        "bg": {
          "app": "#F7F7FA",
          "page": "#F7F7FA",
          "surface": "#FFFFFF",
          "raised": "#FFFFFF",
          "sunken": "#F2F4F7",
          "hover": "#EEF1F5",
          "active": "#E8ECF3",
          "selected": "#ECECFF",
          "overlay": "rgba(15, 23, 42, 0.48)"
        },
        "text": {
          "primary": "#1F2937",
          "secondary": "#667085",
          "tertiary": "#7A8599",
          "muted": "#98A2B3",
          "disabled": "#B6BEC9",
          "inverse": "#FFFFFF",
          "link": "#5B5BD6",
          "linkHover": "#4B4BC3"
        },
        "icon": {
          "primary": "#344054",
          "secondary": "#667085",
          "muted": "#98A2B3"
        },
        "border": {
          "subtle": "#ECEFF3",
          "default": "#E5E7EB",
          "strong": "#D0D5DD",
          "hover": "#BFC6D4"
        },
        "focus": {
          "default": "#5B5BD6",
          "ring": "#A5B4FC"
        },
        "brand": {
          "default": "#5B5BD6",
          "hover": "#4B4BC3",
          "active": "#3F3FB4",
          "soft": "#ECECFF",
          "softer": "#F5F5FF",
          "onBrand": "#FFFFFF"
        },
        "success": {
          "default": "#2F9E74",
          "bg": "#E7F6EF",
          "text": "#1F7A57"
        },
        "danger": {
          "default": "#E25555",
          "bg": "#FDECEC",
          "text": "#B93838"
        },
        "warning": {
          "default": "#D4A72C",
          "bg": "#FFF7E0",
          "text": "#8A6500"
        },
        "info": {
          "default": "#5B8DEF",
          "bg": "#EEF4FF",
          "text": "#3457B1"
        }
      },
      "shadow": {
        "sm": "0 1px 2px rgba(16, 24, 40, 0.04)",
        "md": "0 4px 12px rgba(16, 24, 40, 0.08)",
        "lg": "0 10px 28px rgba(16, 24, 40, 0.12)"
      }
    },
    "dark": {
      "color": {
        "bg": {
          "app": "#0F172A",
          "page": "#0F172A",
          "surface": "#111827",
          "raised": "#172033",
          "sunken": "#0D1526",
          "hover": "#182235",
          "active": "#1D2940",
          "selected": "#232C45",
          "overlay": "rgba(0, 0, 0, 0.58)"
        },
        "text": {
          "primary": "#E5E7EB",
          "secondary": "#B7C0CF",
          "tertiary": "#94A3B8",
          "muted": "#7C8BA1",
          "disabled": "#66758B",
          "inverse": "#111827",
          "link": "#8B93FF",
          "linkHover": "#A6ADFF"
        },
        "icon": {
          "primary": "#D1D7E0",
          "secondary": "#94A3B8",
          "muted": "#6B7A90"
        },
        "border": {
          "subtle": "#1E293B",
          "default": "#263245",
          "strong": "#334155",
          "hover": "#41536B"
        },
        "focus": {
          "default": "#8B93FF",
          "ring": "#A5B4FC"
        },
        "brand": {
          "default": "#8B93FF",
          "hover": "#A6ADFF",
          "active": "#BCC2FF",
          "soft": "#232C45",
          "softer": "#1C2440",
          "onBrand": "#0F172A"
        },
        "success": {
          "default": "#63C69D",
          "bg": "#173328",
          "text": "#8BE0B7"
        },
        "danger": {
          "default": "#F07A7A",
          "bg": "#3A1D22",
          "text": "#FFB0B0"
        },
        "warning": {
          "default": "#E5BE57",
          "bg": "#3A3118",
          "text": "#F7DA8A"
        },
        "info": {
          "default": "#7CA7FF",
          "bg": "#16233E",
          "text": "#B7CBFF"
        }
      },
      "shadow": {
        "sm": "0 1px 2px rgba(0, 0, 0, 0.18)",
        "md": "0 6px 18px rgba(0, 0, 0, 0.24)",
        "lg": "0 16px 40px rgba(0, 0, 0, 0.32)"
      }
    }
  },
  "typography": {
    "fontFamily": {
      "sans": "Inter, -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Segoe UI', sans-serif",
      "mono": "'SFMono-Regular', ui-monospace, Menlo, Monaco, Consolas, 'Liberation Mono', monospace"
    },
    "fontSize": {
      "xs": "12px",
      "sm": "14px",
      "md": "16px",
      "lg": "18px",
      "xl": "22px",
      "2xl": "28px",
      "3xl": "36px"
    },
    "fontWeight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "lineHeight": {
      "tight": 1.2,
      "normal": 1.5,
      "relaxed": 1.7
    }
  },
  "spacing": {
    "0": "0px",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px"
  },
  "radius": {
    "xs": "4px",
    "sm": "6px",
    "md": "8px",
    "lg": "12px",
    "xl": "16px",
    "full": "999px"
  },
  "motion": {
    "duration": {
      "fast": "120ms",
      "normal": "180ms",
      "slow": "280ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)"
    }
  },
  "semantic": {
    "light": {
      "appBackground": "{themes.light.color.bg.page}",
      "surfaceBackground": "{themes.light.color.bg.surface}",
      "surfaceSubtleBackground": "{themes.light.color.bg.sunken}",
