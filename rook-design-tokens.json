          "textSecondary": "{themes.dark.color.text.secondary}"
        }
      }
    },
    "sidebar": {
      "light": {
        "background": "{themes.light.color.bg.surface}",
        "itemText": "{themes.light.color.text.secondary}",
        "itemHoverBackground": "{themes.light.color.bg.hover}",
        "itemHoverText": "{themes.light.color.text.primary}",
        "itemActiveBackground": "{themes.light.color.bg.selected}",
        "itemActiveText": "{themes.light.color.brand.default}",
        "border": "{themes.light.color.border.subtle}"
      },
      "dark": {
        "background": "{themes.dark.color.bg.surface}",
        "itemText": "{themes.dark.color.text.secondary}",
        "itemHoverBackground": "{themes.dark.color.bg.hover}",
        "itemHoverText": "{themes.dark.color.text.primary}",
        "itemActiveBackground": "{themes.dark.color.bg.selected}",
        "itemActiveText": "{themes.dark.color.brand.default}",
        "border": "{themes.dark.color.border.subtle}"
      }
    },
    "search": {
      "light": {
        "background": "{themes.light.color.bg.surface}",
        "border": "{themes.light.color.border.default}",
        "text": "{themes.light.color.text.primary}",
        "placeholder": "{themes.light.color.text.muted}"
      },
      "dark": {
        "background": "{themes.dark.color.bg.surface}",
        "border": "{themes.dark.color.border.default}",
        "text": "{themes.dark.color.text.primary}",
        "placeholder": "{themes.dark.color.text.muted}"
      }
    },
    "badge": {
      "today": {
        "light": {
          "background": "{themes.light.color.success.bg}",
          "text": "{themes.light.color.success.text}",
          "border": "transparent"
        },
        "dark": {
          "background": "{themes.dark.color.success.bg}",
          "text": "{themes.dark.color.success.text}",
          "border": "transparent"
        }
      },
