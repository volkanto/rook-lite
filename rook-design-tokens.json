  "aliases": {
    "light": {
      "--bg": "{themes.light.color.bg.page}",
      "--surface": "{themes.light.color.bg.surface}",
      "--surface-sunk": "{themes.light.color.bg.sunken}",
      "--surface-lift": "{themes.light.color.bg.raised}",
      "--text": "{themes.light.color.text.primary}",
      "--text-soft": "{themes.light.color.text.secondary}",
      "--muted": "{themes.light.color.text.muted}",
      "--border": "{themes.light.color.border.default}",
      "--border-strong": "{themes.light.color.border.strong}",
      "--accent": "{themes.light.color.brand.default}",
      "--accent-soft": "{themes.light.color.brand.soft}",
      "--accent-text": "{themes.light.color.brand.onBrand}",
      "--button": "{themes.light.color.brand.default}",
      "--button-hover": "{themes.light.color.brand.hover}",
      "--danger": "{themes.light.color.danger.default}",
      "--danger-soft": "{themes.light.color.danger.bg}"
    },
    "dark": {
      "--bg": "{themes.dark.color.bg.page}",
      "--surface": "{themes.dark.color.bg.surface}",
      "--surface-sunk": "{themes.dark.color.bg.sunken}",
      "--surface-lift": "{themes.dark.color.bg.raised}",
      "--text": "{themes.dark.color.text.primary}",
      "--text-soft": "{themes.dark.color.text.secondary}",
      "--muted": "{themes.dark.color.text.muted}",
      "--border": "{themes.dark.color.border.default}",
      "--border-strong": "{themes.dark.color.border.strong}",
      "--accent": "{themes.dark.color.brand.default}",
      "--accent-soft": "{themes.dark.color.brand.soft}",
      "--accent-text": "{themes.dark.color.brand.onBrand}",
      "--button": "{themes.dark.color.brand.default}",
      "--button-hover": "{themes.dark.color.brand.hover}",
      "--danger": "{themes.dark.color.danger.default}",
      "--danger-soft": "{themes.dark.color.danger.bg}"
    }
  },
  "agentInstructions": {
    "must": [
      "Do not redesign layout, spacing, or typography unless needed for accessibility.",
      "Do not introduce hardcoded colors where a token exists.",
      "Use semantic tokens first, aliases only for legacy compatibility.",
      "Preserve support for explicit light mode, explicit dark mode, and system theme.",
      "Ensure explicit user-selected theme overrides system theme.",
      "Keep cards neutral.",
      "Keep borders subtle.",
      "Keep shadows subtle.",
      "Keep focus states visible."
    ],
    "mustNot": [
      "Do not use gradients.",
      "Do not use glow effects.",
      "Do not use pure black backgrounds in dark mode.",
      "Do not use green as a generic brand color.",
      "Do not make ordinary note cards colorful.",
      "Do not use multiple accent colors decoratively on a single screen.",
      "Do not remove existing functional selectors."
    ],
    "priorityAreas": [
      "editor",
      "note cards",
      "sidebar",
      "active navigation",
      "search",
      "buttons",
      "badges",
      "focus states",
      "light theme",
      "dark theme"
    ]
  }
}