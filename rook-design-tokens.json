      "surfaceActiveBackground": "{themes.light.color.bg.active}",
      "surfaceSelectedBackground": "{themes.light.color.bg.selected}",
      "overlayBackground": "{themes.light.color.bg.overlay}",
      "textPrimary": "{themes.light.color.text.primary}",
      "textSecondary": "{themes.light.color.text.secondary}",
      "textMuted": "{themes.light.color.text.muted}",
      "textDisabled": "{themes.light.color.text.disabled}",
      "textLink": "{themes.light.color.text.link}",
      "iconPrimary": "{themes.light.color.icon.primary}",
      "iconSecondary": "{themes.light.color.icon.secondary}",
      "borderSubtle": "{themes.light.color.border.subtle}",
      "borderDefault": "{themes.light.color.border.default}",
      "borderStrong": "{themes.light.color.border.strong}",
      "focus": "{themes.light.color.focus.default}",
      "focusRing": "{themes.light.color.focus.ring}",
      "brand": "{themes.light.color.brand.default}",
      "brandHover": "{themes.light.color.brand.hover}",
      "brandActive": "{themes.light.color.brand.active}",
      "brandSoft": "{themes.light.color.brand.soft}",
      "onBrand": "{themes.light.color.brand.onBrand}",
      "success": "{themes.light.color.success.default}",
      "successBg": "{themes.light.color.success.bg}",
      "successText": "{themes.light.color.success.text}",
      "danger": "{themes.light.color.danger.default}",
      "dangerBg": "{themes.light.color.danger.bg}",
      "dangerText": "{themes.light.color.danger.text}",
      "warning": "{themes.light.color.warning.default}",
      "warningBg": "{themes.light.color.warning.bg}",
      "warningText": "{themes.light.color.warning.text}",
      "info": "{themes.light.color.info.default}",
      "infoBg": "{themes.light.color.info.bg}",
      "infoText": "{themes.light.color.info.text}"
    },
    "dark": {
      "appBackground": "{themes.dark.color.bg.page}",
      "surfaceBackground": "{themes.dark.color.bg.surface}",
      "surfaceSubtleBackground": "{themes.dark.color.bg.sunken}",
      "surfaceHoverBackground": "{themes.dark.color.bg.hover}",
      "surfaceActiveBackground": "{themes.dark.color.bg.active}",
      "surfaceSelectedBackground": "{themes.dark.color.bg.selected}",
      "overlayBackground": "{themes.dark.color.bg.overlay}",
      "textPrimary": "{themes.dark.color.text.primary}",
      "textSecondary": "{themes.dark.color.text.secondary}",
      "textMuted": "{themes.dark.color.text.muted}",
      "textDisabled": "{themes.dark.color.text.disabled}",
      "textLink": "{themes.dark.color.text.link}",
      "iconPrimary": "{themes.dark.color.icon.primary}",
      "iconSecondary": "{themes.dark.color.icon.secondary}",
      "borderSubtle": "{themes.dark.color.border.subtle}",
      "borderDefault": "{themes.dark.color.border.default}",
      "borderStrong": "{themes.dark.color.border.strong}",
      "focus": "{themes.dark.color.focus.default}",
      "focusRing": "{themes.dark.color.focus.ring}",
      "brand": "{themes.dark.color.brand.default}",
      "brandHover": "{themes.dark.color.brand.hover}",
      "brandActive": "{themes.dark.color.brand.active}",
      "brandSoft": "{themes.dark.color.brand.soft}",
      "onBrand": "{themes.dark.color.brand.onBrand}",
      "success": "{themes.dark.color.success.default}",
      "successBg": "{themes.dark.color.success.bg}",
      "successText": "{themes.dark.color.success.text}",
      "danger": "{themes.dark.color.danger.default}",
      "dangerBg": "{themes.dark.color.danger.bg}",
      "dangerText": "{themes.dark.color.danger.text}",
      "warning": "{themes.dark.color.warning.default}",
      "warningBg": "{themes.dark.color.warning.bg}",
      "warningText": "{themes.dark.color.warning.text}",
      "info": "{themes.dark.color.info.default}",
      "infoBg": "{themes.dark.color.info.bg}",
      "infoText": "{themes.dark.color.info.text}"
    }
  },
  "components": {
    "button": {
      "primary": {
        "light": {
          "background": "{themes.light.color.brand.default}",
          "backgroundHover": "{themes.light.color.brand.hover}",
          "backgroundActive": "{themes.light.color.brand.active}",
          "text": "{themes.light.color.brand.onBrand}",
          "border": "{themes.light.color.brand.default}"
        },
        "dark": {
          "background": "{themes.dark.color.brand.default}",
          "backgroundHover": "{themes.dark.color.brand.hover}",
          "backgroundActive": "{themes.dark.color.brand.active}",
          "text": "{themes.dark.color.brand.onBrand}",
          "border": "{themes.dark.color.brand.default}"
        }
      },
      "secondary": {
        "light": {
          "background": "{themes.light.color.bg.surface}",
          "backgroundHover": "{themes.light.color.bg.hover}",
          "text": "{themes.light.color.text.primary}",
          "border": "{themes.light.color.border.default}"
        },
        "dark": {
          "background": "{themes.dark.color.bg.surface}",
          "backgroundHover": "{themes.dark.color.bg.hover}",
          "text": "{themes.dark.color.text.primary}",
          "border": "{themes.dark.color.border.default}"
        }
      },
      "destructive": {
        "light": {
          "background": "{themes.light.color.danger.default}",
          "backgroundHover": "#CF4848",
          "text": "#FFFFFF",
          "border": "{themes.light.color.danger.default}"
        },
        "dark": {
          "background": "{themes.dark.color.danger.default}",
          "backgroundHover": "#F59090",
          "text": "#111827",
          "border": "{themes.dark.color.danger.default}"
        }
      }
    },
    "input": {
      "light": {
        "background": "{themes.light.color.bg.surface}",
        "text": "{themes.light.color.text.primary}",
        "placeholder": "{themes.light.color.text.muted}",
        "border": "{themes.light.color.border.default}",
        "borderHover": "{themes.light.color.border.hover}",
        "borderFocus": "{themes.light.color.focus.default}",
        "focusRing": "{themes.light.color.focus.ring}"
      },
      "dark": {
        "background": "{themes.dark.color.bg.surface}",
        "text": "{themes.dark.color.text.primary}",
        "placeholder": "{themes.dark.color.text.muted}",
        "border": "{themes.dark.color.border.default}",
        "borderHover": "{themes.dark.color.border.hover}",
        "borderFocus": "{themes.dark.color.focus.default}",
        "focusRing": "{themes.dark.color.focus.ring}"
      }
    },
    "editor": {
      "light": {
        "background": "{themes.light.color.bg.surface}",
        "border": "{themes.light.color.border.default}",
        "borderFocus": "{themes.light.color.focus.default}",
        "focusRing": "0 0 0 3px rgba(165, 180, 252, 0.18)",
        "toolbarBackground": "{themes.light.color.bg.surface}",
        "toolbarBorder": "{themes.light.color.border.subtle}",
        "placeholder": "{themes.light.color.text.muted}"
      },
      "dark": {
        "background": "{themes.dark.color.bg.surface}",
        "border": "{themes.dark.color.border.default}",
        "borderFocus": "{themes.dark.color.focus.default}",
        "focusRing": "0 0 0 3px rgba(165, 180, 252, 0.18)",
        "toolbarBackground": "{themes.dark.color.bg.surface}",
        "toolbarBorder": "{themes.dark.color.border.subtle}",
        "placeholder": "{themes.dark.color.text.muted}"
      }
    },
    "card": {
      "note": {
        "light": {
          "background": "{themes.light.color.bg.surface}",
          "border": "{themes.light.color.border.subtle}",
          "borderHover": "{themes.light.color.border.default}",
          "shadow": "{themes.light.shadow.sm}",
          "textPrimary": "{themes.light.color.text.primary}",
          "textSecondary": "{themes.light.color.text.secondary}"
        },
        "dark": {
          "background": "{themes.dark.color.bg.surface}",
          "border": "{themes.dark.color.border.subtle}",
          "borderHover": "{themes.dark.color.border.default}",
          "shadow": "{themes.dark.shadow.sm}",
