        "light": {
          "background": "{themes.light.color.warning.bg}",
          "text": "{themes.light.color.warning.text}",
          "border": "transparent"
        },
        "dark": {
          "background": "{themes.dark.color.warning.bg}",
          "text": "{themes.dark.color.warning.text}",
          "border": "transparent"
        }
      },
      "danger": {
        "light": {
          "background": "{themes.light.color.danger.bg}",
          "text": "{themes.light.color.danger.text}",
          "border": "transparent"
        },
        "dark": {
          "background": "{themes.dark.color.danger.bg}",
          "text": "{themes.dark.color.danger.text}",
          "border": "transparent"
        }
      }
    }
